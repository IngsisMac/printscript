let nombre: string = readInput("Ingresá tu nombre: ");
let edad: number = readInput("Ingresá tu edad: ");
let usuarioSo: string = readEnv("USER");

println("¡Hola " + nombre + "!");
println("El año que viene vas a tener: " + (edad + 1));
println("Tu usuario de Linux reportado por readEnv('USER') es: " + usuarioSo);
