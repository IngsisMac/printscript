@startuml
skinparam classAttributeIconSize 0

package "com.printscript.interpreter" {

    interface InterpreterContext {
        + version : Version
        + output : OutputEmitter
        + input : InputSource
        + env : EnvSource
        + isValidationMode : Boolean
        + executeStatement(stmt : Statement, env : Environment)
        + evaluateExpression(expr : Expression, env : Environment) : Value
    }

    class Interpreter implements InterpreterContext {
        - globalEnv : Environment
        - errors : List<PrintScriptError>
        - config : InterpreterConfig
        + execute(statements : Iterator<Statement>) : List<PrintScriptError>
    }

    class InterpreterConfig {
        + statementEvaluators : Map<KClass<out Statement>, StatementEvaluator<*>>
        + expressionEvaluators : Map<KClass<out Expression>, ExpressionEvaluator<*>>
        + version : Version
        + {static} from(version : Version) : InterpreterConfig
    }

    class StatementEvaluatorFactory {
        + {static} create(version : Version) : Map<KClass<out Statement>, StatementEvaluator<*>>
    }

    class ExpressionEvaluatorFactory {
        + {static} create(version : Version) : Map<KClass<out Expression>, ExpressionEvaluator<*>>
    }

    interface StatementEvaluator<in T> {
        + evaluate(statement : T, env : Environment, context : InterpreterContext)
    }

    interface ExpressionEvaluator<in T> {
        + evaluate(expression : T, env : Environment, context : InterpreterContext) : Value
    }

    class Environment {
        - parent : Environment?
        - variables : Map<String, Symbol>
        + define(name : String, type : String, isConst : Boolean, value : Value?, span : Span)
        + set(name : String, value : Value, span : Span)
        + get(name : String, span : Span) : Value
        + getSymbol(name : String) : Symbol?
        + child() : Environment
    }

    class Symbol {
        + name : String
        + type : String
        + isConst : Boolean
        + isInitialized : Boolean
        + value : Value?
    }

    abstract class Value {
        + typeName : String
        + toNumber(span : Span) : BigDecimal
    }

    class NumberValue extends Value {
        + value : BigDecimal
    }

    class StringValue extends Value {
        + value : String
    }

    class BooleanValue extends Value {
        + value : Boolean
    }

    class InterpreterException {
        + message : String
        + rawMessage : String
        + span : Span
    }

    Interpreter --> "1" Environment : globalEnv
    Interpreter --> "1" InterpreterConfig : config
    InterpreterConfig ..> StatementEvaluatorFactory
    InterpreterConfig ..> ExpressionEvaluatorFactory
    Environment --> "0..1" Environment : parent
    Environment *-- "*" Symbol : variables
    Symbol --> "0..1" Value : value
}

@enduml
