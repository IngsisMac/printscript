@startuml
skinparam classAttributeIconSize 0

package "com.printscript.cli" {

    class MainKt {
        + {static} main(args : Array<String>)
    }

    class PrintScriptCli implements Callable {
        + spec : CommandSpec?
        + customReader : BufferedReader?
        + call() : Int
        - runInteractiveLoop(reader : BufferedReader, out : PrintWriter, err : PrintWriter) : Int
        - processLine(line : String, out : PrintWriter, err : PrintWriter) : Boolean
    }
}

package "com.printscript.cli.commands" {
    class ValidateCommand implements Callable {
        + call() : Int
    }

    class ExecuteCommand implements Callable {
        + call() : Int
    }

    class FormatCommand implements Callable {
        + call() : Int
    }

    class AnalyzeCommand implements Callable {
        + call() : Int
    }

    class DemoCommand implements Callable {
        + call() : Int
    }
}

package "com.printscript.cli.util" {
    class CommandLineTokenizer {
        + {static} tokenize(commandLine : String) : List<String>
    }
    class ConfigLoader {
        + {static} load(configFile : File?) : Map<String, Any?>
    }
}

MainKt ..> PrintScriptCli
PrintScriptCli *-- ValidateCommand
PrintScriptCli *-- ExecuteCommand
PrintScriptCli *-- FormatCommand
PrintScriptCli *-- AnalyzeCommand
PrintScriptCli *-- DemoCommand

PrintScriptCli ..> CommandLineTokenizer

ValidateCommand ..> com.printscript.runner.PrintScriptRunner
ExecuteCommand ..> com.printscript.runner.PrintScriptRunner
FormatCommand ..> com.printscript.runner.PrintScriptRunner
AnalyzeCommand ..> com.printscript.runner.PrintScriptRunner

@enduml
