@startuml
skinparam classAttributeIconSize 0

package "com.printscript.runner" {

    class PrintScriptRunner << (O, #FF7700) singleton >> {
        + execute(source : Reader, version : Version, output : OutputEmitter, input : InputSource, env : EnvSource, onProgress : Function) : ExecutionResult
        + validate(source : Reader, version : Version, onProgress : Function) : ExecutionResult
        + format(source : Reader, version : Version, config : Map<String, Any?>, writer : Writer, onProgress : Function) : ExecutionResult
        + format(source : Reader, version : Version, config : Reader, writer : Writer, onProgress : Function) : ExecutionResult
        + analyze(source : Reader, version : Version, config : Map<String, Any?>, onError : Function, onProgress : Function) : ExecutionResult
        + analyze(source : Reader, version : Version, config : Reader, onError : Function, onProgress : Function) : ExecutionResult
    }

    class ExecutionResult {
        + errors : List<PrintScriptError>
    }

    class ConfigLoader {
        + {static} parseJsonToMap(reader : Reader) : Map<String, Any?>
    }

    PrintScriptRunner ..> ExecutionResult
    PrintScriptRunner ..> ConfigLoader
}

@enduml
