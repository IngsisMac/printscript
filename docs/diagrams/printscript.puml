@startuml
skinparam classAttributeIconSize 0

package "com.printscript.common" {
    enum Version {
        V1_0
        V1_1
        + identifier : String
        + {static} from(id : String) : Result<Version>
    }
    class Position {
        + line : Int
        + column : Int
    }
    class Span {
        + start : Position
        + end : Position
    }
    interface OutputEmitter {
        + print(message : String)
    }
    interface InputSource {
        + input(prompt : String) : String
    }
    interface EnvSource {
        + env(name : String) : String?
        + {static} DENY : EnvSource
        + {static} SYSTEM : EnvSource
    }
    class PrintScriptError {
        + message : String
        + span : Span
        + render() : String
    }
}

package "com.printscript.token" {
    enum TokenType {
        LET, CONST, NUMBER, STRING, BOOLEAN
        IF, ELSE, PRINTLN, READ_INPUT, READ_ENV
        PLUS, MINUS, STAR, SLASH, EQUAL
        LPAREN, RPAREN, LBRACE, RBRACE, SEMICOLON, COMMA, COLON
        IDENTIFIER, NUMBER_LITERAL, STRING_LITERAL, TRUE, FALSE
        EOF
    }
    class Token {
        + type : TokenType
        + lexeme : String
        + span : Span
    }
}

package "com.printscript.ast" {
    interface AstNode {
        + span : Span
        + accept(visitor : AstVisitor<R>) : R
    }
    abstract class Statement implements AstNode {
        + span : Span
    }
    abstract class Expression implements AstNode {
        + span : Span
    }
}

package "com.printscript.lexer" {
    class Lexer implements Iterator {
        + hasNext() : Boolean
        + next() : Token
    }
}

package "com.printscript.parser" {
    class Parser {
        + parse() : Iterator<Statement>
        + parseNextStatement() : Statement?
        + parseExpression(minBp : Int) : Expression
    }
}

package "com.printscript.interpreter" {
    class Interpreter {
        + execute(statements : Iterator<Statement>) : List<PrintScriptError>
    }
}

package "com.printscript.formatter" {
    interface Formatter {
        + format(statement : Statement, writer : Writer, config : FormatterConfig)
    }
}

package "com.printscript.linter" {
    interface Linter {
        + analyze(statements : Iterator<Statement>, config : LinterConfig, onError : Function) : List<PrintScriptError>
    }
}

package "com.printscript.runner" {
    class PrintScriptRunner << (O, #FF7700) singleton >> {
        + execute(source : Reader, version : Version, output : OutputEmitter, input : InputSource, env : EnvSource) : ExecutionResult
        + validate(source : Reader, version : Version) : ExecutionResult
        + format(source : Reader, version : Version, config : Map, writer : Writer) : ExecutionResult
        + analyze(source : Reader, version : Version, config : Map, onError : Function) : ExecutionResult
    }
    class ExecutionResult {
        + errors : List<PrintScriptError>
    }
}

Token --> TokenType
Token --> Span
Statement --> Span
Expression --> Span

Lexer ..|> Iterator
Lexer ..> Token

Parser ..> Token
Parser ..> Statement

Interpreter ..> Statement
Interpreter ..> OutputEmitter
Interpreter ..> InputSource
Interpreter ..> EnvSource

Formatter ..> Statement
Linter ..> Statement

PrintScriptRunner ..> Lexer
PrintScriptRunner ..> Parser
PrintScriptRunner ..> Interpreter
PrintScriptRunner ..> Formatter
PrintScriptRunner ..> Linter
PrintScriptRunner ..> ExecutionResult

@enduml
