@startuml
skinparam classAttributeIconSize 0

package "com.printscript.token" {

    enum TokenType {
        LET
        CONST
        NUMBER
        STRING
        BOOLEAN
        IF
        ELSE
        PRINTLN
        READ_INPUT
        READ_ENV
        PLUS
        MINUS
        STAR
        SLASH
        EQUAL
        LPAREN
        RPAREN
        LBRACE
        RBRACE
        SEMICOLON
        COMMA
        COLON
        IDENTIFIER
        NUMBER_LITERAL
        STRING_LITERAL
        TRUE
        FALSE
        EOF
    }

    class Token {
        + type : TokenType
        + lexeme : String
        + span : Span
    }

    Token --> "1" TokenType : type
}

@enduml
