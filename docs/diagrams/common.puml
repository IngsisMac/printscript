@startuml
skinparam classAttributeIconSize 0

package "com.printscript.common" {

    class Position {
        + line : Int
        + column : Int
        + compareTo(other : Position) : Int
    }

    class Span {
        + start : Position
        + end : Position
        + contains(position : Position) : Boolean
    }

    enum Version {
        V1_0
        V1_1
        + identifier : String
        + {static} from(id : String) : Result<Version>
    }

    interface OutputEmitter {
        + print(message : String)
    }

    interface InputSource {
        + input(prompt : String) : String
    }

    interface EnvSource {
        + env(name : String) : String?
        + {static} DENY : EnvSource
        + {static} SYSTEM : EnvSource
    }

    interface PrintScriptFailure {
        + rawMessage : String
        + span : Span
    }

    class PrintScriptError {
        + message : String
        + span : Span
        + render() : String
    }

    Span *-- "1" Position : start
    Span *-- "1" Position : end
    PrintScriptError --> "1" Span : span
}

@enduml
