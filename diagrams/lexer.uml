@startuml
skinparam classAttributeIconSize 0

package "com.printscript.lexer" {

    interface Lexer {
        + hasNext() : Boolean
        + next() : Token
    }

    class DefaultLexer {
        - stream : CharStream
        - matchers : List<TokenMatcher>
        + hasNext() : Boolean
        + next() : Token
    }

    class CharStream {
        - reader : Reader
        - currentLine : Int
        - currentColumn : Int
        + peek() : Char
        + read() : Char
        + skipWhitespace()
        + getPosition() : Position
    }

    interface TokenMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class KeywordMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class IdentifierMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class NumberMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class StringMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class OperatorMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class SymbolMatcher {
        + canMatch(stream : CharStream) : Boolean
        + match(stream : CharStream) : Token
    }

    class TokenConfig {
        + version : Version
        + getMatchers() : List<TokenMatcher>
    }

    class LexerException {
        + message : String
        + position : Position
    }

    Lexer <|.. DefaultLexer
    DefaultLexer --> "1" CharStream : stream
    DefaultLexer --> "*" TokenMatcher : matchers

    TokenMatcher <|.. KeywordMatcher
    TokenMatcher <|.. IdentifierMatcher
    TokenMatcher <|.. NumberMatcher
    TokenMatcher <|.. StringMatcher
    TokenMatcher <|.. OperatorMatcher
    TokenMatcher <|.. SymbolMatcher

    DefaultLexer ..> TokenConfig
}

@enduml
