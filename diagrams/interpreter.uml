@startuml
skinparam classAttributeIconSize 0

package "com.printscript.interpreter" {

    interface Interpreter {
        + execute(statement : Statement)
    }

    class DefaultInterpreter {
        - context : InterpreterContext
        - statementEvaluator : StatementEvaluator
        + execute(statement : Statement)
    }

    class InterpreterContext {
        + environment : Environment
        + emitter : OutputEmitter
        + inputSource : InputSource
        + envSource : EnvSource
        + isValidationMode : Boolean
    }

    class Environment {
        - parent : Environment
        - variables : Map<String, SymbolValue>
        + declare(name : String, value : Any, isConst : Boolean)
        + assign(name : String, value : Any)
        + get(name : String) : Any
        + createChild() : Environment
    }

    class SymbolValue {
        + value : Any
        + isConst : Boolean
        + type : String
    }

    class StatementEvaluator {
        - expressionEvaluator : ExpressionEvaluator
        + evaluate(statement : Statement, context : InterpreterContext)
    }

    class ExpressionEvaluator {
        + evaluate(expression : Expression, context : InterpreterContext) : ValueResult
    }

    class ValueResult {
        + value : Any
        + type : String
    }

    Interpreter <|.. DefaultInterpreter
    DefaultInterpreter --> "1" InterpreterContext : context
    DefaultInterpreter --> "1" StatementEvaluator : statementEvaluator
    StatementEvaluator --> "1" ExpressionEvaluator : expressionEvaluator
    InterpreterContext --> "1" Environment : environment
    Environment --> "0..1" Environment : parent
    Environment *-- "*" SymbolValue : variables
}

@enduml
