@startuml
skinparam classAttributeIconSize 0

package "com.printscript.ast" {

    interface Statement {
        + span : Span
    }

    interface Expression {
        + span : Span
    }

    class VariableDeclaration {
        + identifier : String
        + type : String
        + isConst : Boolean
        + initializer : Expression
        + span : Span
    }

    class Assignation {
        + identifier : String
        + value : Expression
        + span : Span
    }

    class PrintStatement {
        + expression : Expression
        + span : Span
    }

    class IfStatement {
        + condition : Expression
        + thenBlock : List<Statement>
        + elseBlock : List<Statement>
        + span : Span
    }

    Statement <|.. VariableDeclaration
    Statement <|.. Assignation
    Statement <|.. PrintStatement
    Statement <|.. IfStatement

    class IdentifierNode {
        + name : String
        + span : Span
    }

    enum LiteralType {
        NUMBER
        STRING
        BOOLEAN
    }

    class LiteralNode {
        + value : Any
        + type : LiteralType
        + span : Span
    }

    class BinaryExpressionNode {
        + left : Expression
        + operator : String
        + right : Expression
        + span : Span
    }

    class UnaryExpressionNode {
        + operator : String
        + operand : Expression
        + span : Span
    }

    class ReadInputNode {
        + prompt : Expression
        + span : Span
    }

    class ReadEnvNode {
        + name : Expression
        + span : Span
    }

    Expression <|.. IdentifierNode
    Expression <|.. LiteralNode
    Expression <|.. BinaryExpressionNode
    Expression <|.. UnaryExpressionNode
    Expression <|.. ReadInputNode
    Expression <|.. ReadEnvNode

    VariableDeclaration --> "0..1" Expression : initializer
    Assignation --> "1" Expression : value
    PrintStatement --> "1" Expression : expression
    IfStatement --> "1" Expression : condition
    IfStatement --> "*" Statement : thenBlock
    IfStatement --> "*" Statement : elseBlock
    BinaryExpressionNode --> "1" Expression : left
    BinaryExpressionNode --> "1" Expression : right
    UnaryExpressionNode --> "1" Expression : operand
    LiteralNode --> "1" LiteralType : type
}

@enduml
