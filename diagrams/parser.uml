@startuml
skinparam classAttributeIconSize 0

package "com.printscript.parser" {

    class Parser {
        - tokenStream : TokenStream
        - statementParsers : List<StatementParser>
        - expressionParser : ExpressionParser
        + parse() : Iterator<Statement>
        + parseNextStatement() : Statement
        + parseExpression(minBp : Int) : Expression
    }

    class ParserConfig {
        + statementParsers : List<StatementParser>
        + prefixParsers : List<PrefixParser>
        + infixParsers : List<InfixParser>
        + version : Version
        + {static} from(version : Version) : ParserConfig
    }

    class StatementParserFactory {
        + {static} create(version : Version) : List<StatementParser>
    }

    class ExpressionParserFactory {
        + {static} createPrefixParsers(version : Version) : List<PrefixParser>
        + {static} createInfixParsers() : List<InfixParser>
        + {static} create(version : Version) : ExpressionParser
    }

    class TokenStream {
        - tokenIterator : Iterator<Token>
        + peek() : Token
        + consume() : Token
        + expect(type : TokenType) : Token
        + match(type : TokenType) : Boolean
    }

    class ExpressionParser {
        - prefixParsers : List<PrefixParser>
        - infixParsers : List<InfixParser>
        + parseExpression(stream : TokenStream, minBp : Int) : Expression
        + parseUnaryExpression(stream : TokenStream) : Expression
    }
}

package "com.printscript.parser.statement" {
    interface StatementParser {
        + matches(stream : TokenStream) : Boolean
        + parse(stream : TokenStream, parser : Parser) : Statement
    }
    class DeclarationStatementParser implements StatementParser
    class AssignmentStatementParser implements StatementParser
    class PrintStatementParser implements StatementParser
    class IfStatementParser implements StatementParser
}

package "com.printscript.parser.expression.prefix" {
    interface PrefixParser {
        + matches(token : Token) : Boolean
        + parse(token : Token, stream : TokenStream, parser : ExpressionParser) : Expression
    }
    class NumberLiteralPrefixParser implements PrefixParser
    class StringLiteralPrefixParser implements PrefixParser
    class BooleanLiteralPrefixParser implements PrefixParser
    class IdentifierOrCallPrefixParser implements PrefixParser
    class ReadFunctionPrefixParser implements PrefixParser
    class UnaryOperatorPrefixParser implements PrefixParser
    class GroupedExpressionPrefixParser implements PrefixParser
}

package "com.printscript.parser.expression.infix" {
    interface InfixParser {
        + leftBindingPower : Int
        + rightBindingPower : Int
        + matches(token : Token) : Boolean
        + parse(left : Expression, opToken : Token, stream : TokenStream, parser : ExpressionParser) : Expression
    }
    class BinaryOperatorInfixParser implements InfixParser
}

Parser --> TokenStream
Parser --> "1..*" StatementParser
Parser --> ExpressionParser
Parser ..> ParserConfig

ParserConfig --> "1..*" StatementParser
ParserConfig --> "1..*" PrefixParser
ParserConfig --> "1..*" InfixParser

StatementParserFactory ..> StatementParser
ExpressionParserFactory ..> PrefixParser
ExpressionParserFactory ..> InfixParser

ExpressionParser --> "1..*" PrefixParser
ExpressionParser --> "1..*" InfixParser

@enduml
